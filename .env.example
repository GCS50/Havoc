# ---- Database ----
# Inside docker-compose the host is "db"; for local runs use "localhost".
DATABASE_URL=postgresql+asyncpg://havoc:havoc@db:5432/havoc

# ---- JWT ----
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---- Defaults ----
DEFAULT_PROJECT_ID=moon

# ---- Bootstrap admin (used by scripts/seed_admin.py) ----
ADMIN_EMAIL=admin@havoc.local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Havoc Admin
